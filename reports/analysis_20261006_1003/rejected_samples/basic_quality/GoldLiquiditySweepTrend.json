  "idea": {
    "spec": {
      "name": "GoldLiquiditySweepTrend",
      "timeframe": "1h",
      "hypothesis": "XAUUSD exhibits persistent intraday liquidity-seeking behavior where institutional order flow targets recent swing highs/lows to fill large positions before continuing the prevailing trend. Retail traders often place stops just beyond these swings, creating predictable stop runs. When price sweeps a confirmed swing level but closes back within the prior range during active London/NY sessions, it signals absorption and continuation. The losing side is reactive retail traders who get stopped out on false breakouts, while institutions accumulate at better prices.",
      "concept_family": "trend",
      "indicators_used": [
        "liquidity_sweep",
        "ema",
        "atr",
        "is_session"
      ],
      "entry_logic": "Long: Bullish liquidity sweep (low_sweep=True) + close > EMA(20) + London or NY session active. Short: Bearish liquidity sweep (high_sweep=True) + close < EMA(20) + London or NY session active. Requires right-side confirmation via closed bar.",
      "exit_logic": "Stop loss = max(5.0, ATR(14) * sl_mult) USD points from entry. Take profit = max(1.5, ATR(14) * tp_mult) USD points. Both distances strictly positive.",
      "filters": [
        "Active London or NY session only",
        "EMA trend alignment",
        "Confirmed swing sweep with closed-bar validation"
      ],
      "session_filter": "london_ny",
      "direction": "both",
      "parameters": {
        "swing_n": {
          "default": 3,
          "min": 2,
          "max": 6
        },
        "ema_period": {
          "default": 20,
          "min": 10,
          "max": 50
        },
        "atr_period": {
          "default": 14,
          "min": 7,
          "max": 30
        },
        "sl_mult": {
          "default": 1.5,
          "min": 1.0,
          "max": 3.0
        },
        "tp_mult": {
          "default": 2.5,
          "min": 1.5,
          "max": 4.0
        }
      },
      "expected_trades_per_year": 65,
      "expected_failure_conditions": "Extended Asian-session-dominated low-volatility regimes with no clear swing structure or during major macro events causing erratic non-technical price action."
    },
    "code": "class Strategy:\n    PARAMS = {\n        \"swing_n\": {\"default\": 3, \"min\": 2, \"max\": 6},\n        \"ema_period\": {\"default\": 20, \"min\": 10, \"max\": 50},\n        \"atr_period\": {\"default\": 14, \"min\": 7, \"max\": 30},\n        \"sl_mult\": {\"default\": 1.5, \"min\": 1.0, \"max\": 3.0},\n        \"tp_mult\": {\"default\": 2.5, \"min\": 1.5, \"max\": 4.0}\n    }\n\n    def __init__(self, params):\n        self.params = params\n\n    def on_bar(self, bars):\n        if len(bars) < 60:\n            return None\n\n        # Compute indicators\n        high_sweep, low_sweep = liquidity_sweep(bars, swing_n=int(self.params[\"swing_n\"]))\n        ema_val = ema(bars, n=int(self.params[\"ema_period\"])).iloc[-1]\n        atr_series = atr(bars, n=int(self.params[\"atr_period\"]))\n        atr_val = atr_series.iloc[-1]\n        session_active = is_session(bars, \"london\") | is_session(bars, \"ny\")\n        current_session = session_active.iloc[-1]\n\n        # Safety checks\n        if np.isnan(atr_val) or atr_val <= 0:\n            return None\n        if np.isnan(ema_val):\n            return None\n\n        # Ensure minimum trade frequency by avoiding overly strict filters\n        # Only require session + sweep + EMA alignment\n        last_close = bars[\"close\"].iloc[-1]\n\n        # Long setup\n        if low_sweep.iloc[-1] and last_close > ema_val and current_session:\n            sl_dist = max(5.0, float(atr_val * self.params[\"sl_mult\"]))\n            tp_dist = max(1.5, float(atr_val * self.params[\"tp_mult\"]))\n            return Signal.enter_long(sl_distance=sl_dist, tp_distance=tp_dist)\n\n        # Short setup\n        if high_sweep.iloc[-1] and last_close < ema_val and current_session:\n            sl_dist = max(5.0, float(atr_val * self.params[\"sl_mult\"]))\n            tp_dist = max(1.5, float(atr_val * self.params[\"tp_mult\"]))\n            return Signal.enter_short(sl_distance=sl_dist, tp_distance=tp_dist)\n\n        return None"
  },
