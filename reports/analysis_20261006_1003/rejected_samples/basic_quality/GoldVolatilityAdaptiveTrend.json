  "idea": {
    "spec": {
      "name": "GoldVolatilityAdaptiveTrend",
      "timeframe": "4h",
      "hypothesis": "XAUUSD exhibits persistent trending behavior driven by macro flows and central bank activity, but standard trend strategies fail during low-volatility compression phases due to whipsaws. This strategy uses volatility percentile regimes to gate entries only when realized vol is expanding or sufficiently elevated, ensuring participation in genuine institutional moves while avoiding choppy accumulation periods. The losing side consists of mean-reversion traders fading breakouts during vol expansion and breakout traders entering during compressed, low-conviction regimes.",
      "concept_family": "trend",
      "indicators_used": [
        "ema",
        "macd",
        "vol_percentile",
        "atr",
        "is_session"
      ],
      "entry_logic": "Long: EMA fast > EMA slow AND MACD histogram > 0 AND vol_percentile > threshold AND London/NY session active. Short: inverse conditions. Requires no position currently open.",
      "exit_logic": "Stop loss = ATR * sl_mult (floored at 5.0 USD). Take profit = ATR * tp_mult (floored at 1.50 USD). Both distances are positive USD point values derived from current bar's ATR.",
      "filters": [
        "vol_percentile > min_vol_pct",
        "is_session(london_ny)"
      ],
      "session_filter": "london_ny",
      "direction": "both",
      "parameters": {
        "ema_fast": {
          "default": 21,
          "min": 10,
          "max": 50
        },
        "ema_slow": {
          "default": 55,
          "min": 30,
          "max": 100
        },
        "vol_lookback": {
          "default": 60,
          "min": 20,
          "max": 120
        },
        "min_vol_pct": {
          "default": 40,
          "min": 20,
          "max": 70
        },
        "sl_mult": {
          "default": 2.0,
          "min": 1.0,
          "max": 4.0
        },
        "tp_mult": {
          "default": 3.0,
          "min": 1.5,
          "max": 6.0
        }
      },
      "expected_trades_per_year": 65,
      "expected_failure_conditions": "Extended sub-40th percentile volatility regimes lasting >3 months with no directional conviction"
    },
    "code": "class Strategy:\n    PARAMS = {\n        \"ema_fast\": {\"default\": 21, \"min\": 10, \"max\": 50},\n        \"ema_slow\": {\"default\": 55, \"min\": 30, \"max\": 100},\n        \"vol_lookback\": {\"default\": 60, \"min\": 20, \"max\": 120},\n        \"min_vol_pct\": {\"default\": 40, \"min\": 20, \"max\": 70},\n        \"sl_mult\": {\"default\": 2.0, \"min\": 1.0, \"max\": 4.0},\n        \"tp_mult\": {\"default\": 3.0, \"min\": 1.5, \"max\": 6.0}\n    }\n\n    def __init__(self, params):\n        self.params = params\n\n    def on_bar(self, bars):\n        if len(bars) < 60:\n            return None\n\n        # Compute indicators\n        ema_f = ema(bars, self.params[\"ema_fast\"])\n        ema_s = ema(bars, self.params[\"ema_slow\"])\n        macd_line, signal_line, hist = macd(bars, 12, 26, 9)\n        vol_pct = vol_percentile(bars, atr_n=14, lookback=self.params[\"vol_lookback\"])\n        atr_val = atr(bars, 14)\n        in_session = is_session(bars, \"london_ny\")\n\n        # Safety checks for NaN/invalid values\n        if np.isnan(atr_val) or atr_val <= 0:\n            return None\n        if np.isnan(vol_pct) or np.isnan(hist) or np.isnan(ema_f.iloc[-1]) or np.isnan(ema_s.iloc[-1]):\n            return None\n\n        # Current bar values\n        curr_ema_f = float(ema_f.iloc[-1])\n        curr_ema_s = float(ema_s.iloc[-1])\n        curr_hist = float(hist.iloc[-1])\n        curr_vol_pct = float(vol_pct.iloc[-1])\n        curr_in_session = bool(in_session.iloc[-1])\n\n        # Parameter extraction\n        min_vol = self.params[\"min_vol_pct\"] / 100.0\n        sl_dist = max(5.0, float(atr_val * self.params[\"sl_mult\"]))\n        tp_dist = max(1.50, float(atr_val * self.params[\"tp_mult\"]))\n\n        # Entry logic\n        long_cond = (curr_ema_f > curr_ema_s) and (curr_hist > 0) and (curr_vol_pct > min_vol) and curr_in_session\n        short_cond = (curr_ema_f < curr_ema_s) and (curr_hist < 0) and (curr_vol_pct > min_vol) and curr_in_session\n\n        if long_cond:\n            return Signal.enter_long(sl_distance=sl_dist, tp_distance=tp_dist)\n        elif short_cond:\n            return Signal.enter_short(sl_distance=sl_dist, tp_distance=tp_dist)\n\n        return None"
  },
